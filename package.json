{
  "name": "niner-scheduler",
  "version": "1.0.0",
  "private": true,
  "description": "Generate every possible UNC Charlotte class schedule, with professor ratings and grade history.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/engine.test.mjs",
    "scrape": "node scripts/scrape-banner.mjs && node scripts/scrape-rmp.mjs",
    "scrape:banner": "node scripts/scrape-banner.mjs",
    "scrape:rmp": "node scripts/scrape-rmp.mjs",
    "grades": "node scripts/build-grades.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
